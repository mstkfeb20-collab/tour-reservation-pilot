<?xml version="1.0" encoding="UTF-8"?>
<!--
  tazuna の見本プロジェクト。
  案件では groupId / artifactId / パッケージ名を自分の案件のものに置き換える。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.example</groupId>
  <artifactId>tazuna-sample</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>5.11.4</junit.version>
    <archunit.version>1.3.0</archunit.version>

    <!--
      単体のゲート（人がコードをレビューしない代わりに、テストの強さとセキュリティを機械で確かめる）。
      基準値は案件の品質計画で決め、ここに書く。harness/metrics.md の「単体」を参照。
    -->
    <!-- 分岐カバレッジの下限（0.00〜1.00）。テストが通っていない分岐を残さない -->
    <tazuna.coverage.branch.min>0.80</tazuna.coverage.branch.min>
    <!-- ミューテーションスコアの下限（%）。わざと壊したコードを、テストが何割検出できるか -->
    <tazuna.mutation.min>70</tazuna.mutation.min>
    <!-- ミューテーションを掛けるパッケージ（業務ロジックの層）。案件のパッケージ名に合わせる -->
    <tazuna.mutation.targets>com.example.domain.*,com.example.application.*</tazuna.mutation.targets>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <version>${archunit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
      </plugin>

      <!-- 分岐カバレッジ（JaCoCo）。下限を割ると mvn verify が失敗する。レポート: target/site/jacoco/ -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.12</version>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals><goal>prepare-agent</goal></goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>verify</phase>
            <goals><goal>report</goal></goals>
          </execution>
          <execution>
            <id>check</id>
            <phase>verify</phase>
            <goals><goal>check</goal></goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>BRANCH</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${tazuna.coverage.branch.min}</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!--
        ミューテーションテスト（PIT）。コードをわざと壊し、テストが失敗するか（＝検出できるか）を数える。
        アサーションの弱いテストは、カバレッジが高くてもここで落ちる。下限を割ると mvn verify が失敗する。
        レポート: target/pit-reports/。2回目からは前回の結果を使って速くなる（withHistory）。
      -->
      <plugin>
        <groupId>org.pitest</groupId>
        <artifactId>pitest-maven</artifactId>
        <version>1.17.0</version>
        <dependencies>
          <dependency>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-junit5-plugin</artifactId>
            <version>1.2.1</version>
          </dependency>
        </dependencies>
        <configuration>
          <targetClasses>${tazuna.mutation.targets}</targetClasses>
          <mutationThreshold>${tazuna.mutation.min}</mutationThreshold>
          <withHistory>true</withHistory>
          <outputFormats>
            <outputFormat>HTML</outputFormat>
            <outputFormat>XML</outputFormat>
          </outputFormats>
          <timestampedReports>false</timestampedReports>
        </configuration>
        <executions>
          <execution>
            <id>mutation</id>
            <phase>verify</phase>
            <goals><goal>mutationCoverage</goal></goals>
          </execution>
        </executions>
      </plugin>

      <!--
        セキュリティの静的解析（SpotBugs ＋ FindSecBugs）。SQL インジェクション・パストラバーサル・弱い暗号など。
        見るのはセキュリティの分類だけ（scripts/lint/common/spotbugs-security.xml）。見つかれば mvn verify が失敗する。
      -->
      <plugin>
        <groupId>com.github.spotbugs</groupId>
        <artifactId>spotbugs-maven-plugin</artifactId>
        <version>4.8.6.6</version>
        <configuration>
          <effort>Max</effort>
          <threshold>Low</threshold>
          <includeFilterFile>scripts/lint/common/spotbugs-security.xml</includeFilterFile>
          <plugins>
            <plugin>
              <groupId>com.h3xstream.findsecbugs</groupId>
              <artifactId>findsecbugs-plugin</artifactId>
              <version>1.13.0</version>
            </plugin>
          </plugins>
        </configuration>
        <executions>
          <execution>
            <id>security</id>
            <phase>verify</phase>
            <goals><goal>check</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
